# Configuración de Entorno para Línea de Tiempo Patprimo & Pash
# Puedes configurarlas en Vercel sin prefijo (más fácil y sin alertas de seguridad):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_SECRET=your-jwt-secret-key-at-least-32-chars

# O también con prefijo NEXT_PUBLIC_ (si prefieres, marcándolas como "Config" en Vercel):
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
